# Copy to .env.local.

# --- Local (running a browser on the same machine as the codespace/host) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# --- GitHub Codespaces ---
# The app is client-rendered, so your LOCAL browser talks to Supabase directly
# and cannot reach 127.0.0.1 inside the codespace. Instead:
#   1. In the Ports panel, set port 54321 visibility to Public.
#   2. Use the forwarded URL here:
# NEXT_PUBLIC_SUPABASE_URL=https://<codespace-name>-54321.app.github.dev

# Printed by `npx supabase start` (the legacy JWT anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Without it the authority dashboard shows the list view only (no map).
NEXT_PUBLIC_MAPBOX_TOKEN=
